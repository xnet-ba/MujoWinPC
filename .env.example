# MujoWinPC konfiguracija. Kopiraj u .env i popuni:  cp .env.example .env
# NIKAD ne commitaj .env s pravom lozinkom.

# Windows verzija: 10 ili 11 (bira compose/win10.yml ili win11.yml)
WINDOWS_VERSION=11

# Profil resursa: lite | standard | dev | heavy (vidi profiles/)
MUJO_PROFILE=standard

# Korisnik i lozinka za Windows nalog. OBAVEZNO promijeni.
# `mujowin up` se odbija pokrenuti dok je lozinka prazna ili defaultna.
WINDOWS_USERNAME=Docker
WINDOWS_PASSWORD=

# Web prikaz (noVNC). Zadani dockur port; mijenjaj samo ako je zauzet.
WEB_PORT=8006
RDP_PORT=3389

# Kontrolni API (Faza 2). Token je OBAVEZAN za start servera:
#   openssl rand -hex 32
MUJO_API_TOKEN=
MUJO_API_PORT=3001
MUJO_API_BIND=127.0.0.1
